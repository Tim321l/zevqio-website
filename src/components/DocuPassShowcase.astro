---
import content from "../data/docupass-showcase.json";
import result from "../data/docupass-demo-result.json";
import type { Locale } from "../data/locales";
import { withBase } from "../utils/paths";
import Icon from "./Icon.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = content[locale];
const screens = [
  {
    step: 1,
    name: ui.add,
    note: ui.addNote,
    file: "docupass-new-job.png",
    width: 2880,
    height: 1560,
  },
  {
    step: 1,
    name: ui.addLight,
    note: ui.addLightNote,
    file: "docupass-app-home.png",
    width: 2640,
    height: 1560,
  },
  {
    step: 2,
    name: ui.model,
    note: ui.modelNote,
    file: "docupass-recognition.png",
    width: 2880,
    height: 1560,
  },
  {
    step: 3,
    name: ui.review,
    note: ui.reviewNote,
    file: "docupass-review.png",
    width: 2880,
    height: 1560,
  },
  {
    step: 4,
    name: ui.export,
    note: ui.exportNote,
    file: "docupass-export.png",
    width: 1360,
    height: 1416,
  },
];
---

<section
  class="docu-showcase section-space"
  id="docupass-demo"
  aria-labelledby="docu-demo-title"
>
  <div class="shell">
    <div class="showcase-heading">
      <div>
        <p class="eyebrow">
          <span class="eyebrow-line"></span>
          {ui.eyebrow}
        </p>
        <h2 id="docu-demo-title">{ui.title}</h2>
      </div>
      <p>{ui.intro}</p>
    </div>
    <div class="docu-screens">
      {screens.map((screen) => (
        <figure
          class:list={[
            "docu-screen",
            { "docu-screen--export": screen.file === "docupass-export.png" },
          ]}
        >
          <a
            class="docu-screen-image"
            href={withBase(`/images/projects/${screen.file}`)}
            target="_blank"
            rel="noopener"
            aria-label={`${ui.full}: ${screen.name}`}
          >
            <img
              src={withBase(`/images/projects/${screen.file}`)}
              alt={screen.name}
              width={screen.width}
              height={screen.height}
              loading={screen.step === 1 ? "eager" : "lazy"}
            />
          </a>
          <figcaption>
            <span class="docu-stage">0{screen.step}</span>
            <div>
              <h3>{screen.name}</h3>
              <p>{screen.note}</p>
              <a
                class="text-link"
                href={withBase(`/images/projects/${screen.file}`)}
                target="_blank"
                rel="noopener"
              >
                {ui.full}
                <Icon name="arrowUpRight" size={14} />
              </a>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
    <details class="docu-film-details">
      <summary>
        <Icon name="arrowRight" size={16} />
        {ui.watch}
      </summary>
      <figure class="docu-film">
        <video
          controls
          muted
          playsinline
          preload="none"
          poster={withBase("/images/projects/docupass-review.png")}
          aria-label={ui.tour}
        >
          <source
            src={withBase("/videos/docupass-screen-tour.webm")}
            type="video/webm"
          />
        </video>
        <figcaption>
          <div>
            <Icon name="layers" size={18} />
            <strong>{ui.tour}</strong>
          </div>
          <p>{ui.tourNote}</p>
        </figcaption>
      </figure>
    </details>
  </div>
</section>
<section
  class="docu-evidence section-space"
  id="ocr-results"
  aria-labelledby="docu-result-title"
>
  <div class="shell">
    <div class="showcase-heading">
      <div>
        <p class="eyebrow">
          <span class="eyebrow-line"></span>
          {ui.synthetic}
        </p>
        <h2 id="docu-result-title">{ui.results}</h2>
      </div>
      <p>{ui.accuracyNote}</p>
    </div>
    <div class="docu-comparison">
      <figure class="docu-scan">
        <figcaption>{ui.scan}</figcaption>
        <img
          src={withBase("/images/projects/docupass-sample-receipt.jpg")}
          alt={ui.synthetic}
          width="980"
          height="1178"
          loading="lazy"
        />
        <a
          class="text-link"
          href={withBase("/images/projects/docupass-sample-receipt.jpg")}
          target="_blank"
          rel="noopener"
        >
          {ui.sample}
          <Icon name="arrowUpRight" size={16} />
        </a>
      </figure>
      <div class="docu-output">
        <p class="eyebrow">{ui.read}</p>
        <dl>
          <div>
            <dt>{ui.merchant}</dt>
            <dd>{result.document.fields.merchant.value}</dd>
          </div>
          <div class="docu-total">
            <dt>{ui.total}</dt>
            <dd>{result.document.fields.total.value}</dd>
          </div>
        </dl>
        <div class="docu-field-details">
          <div>
            <span>{ui.date}</span>
            <strong>{result.document.fields.date.value}</strong>
          </div>
          <div>
            <span>{ui.receiptNo}</span>
            <strong>{result.document.fields.receipt_no.value}</strong>
          </div>
        </div>
        <details class="docu-items">
          <summary>{ui.items}</summary>
          <ul>
            {result.document.items.map((item) => (
              <li>
                <span>{item.description}</span>
                <strong>{item.amount}</strong>
              </li>
            ))}
          </ul>
          <p>{ui.sum}</p>
          <p>{ui.arithmetic}</p>
        </details>
        <p class="docu-review-note">
          <Icon name="check" size={18} />
          {ui.check}
        </p>
        <a
          class="text-link"
          href={withBase("/downloads/docupass-receipt-result.json")}
          download
        >
          {ui.read} · JSON
          <Icon name="arrowRight" size={16} />
        </a>
      </div>
    </div>
    <aside class="docu-test">
      <div class="docu-test-copy">
        <p class="eyebrow">{ui.test}</p>
        <h3>PP-OCRv6</h3>
        <p>{ui.environment}</p>
        <p class="docu-test-note">{ui.testNote}</p>
      </div>
      <ul>
        {[ui.png, ui.broken, ui.receipt, ui.excel].map((label) => (
          <li>
            <Icon name="check" size={16} />
            {label}
          </li>
        ))}
      </ul>
      <div class="docu-test-links">
        <a
          class="text-link"
          href={withBase("/downloads/docupass-ocr-check.json")}
          download
        >
          {ui.report}
          <Icon name="arrowRight" size={16} />
        </a>
        <a
          class="text-link"
          href={withBase("/downloads/docupass-sample.xlsx")}
          download
        >
          {ui.sampleExcel}
          <Icon name="arrowRight" size={16} />
        </a>
      </div>
    </aside>
  </div>
</section>
