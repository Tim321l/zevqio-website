---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import { withBase } from "../utils/paths";
import {
  getLocaleContent,
  getLocaleFromPath,
  localeHref,
  localeOptions,
  stripLocaleFromPath,
  type Locale,
} from "../data/locales";

const currentPath = Astro.url.pathname;
const { locale = getLocaleFromPath(currentPath) } = Astro.props as {
  locale?: Locale;
};
const copy = getLocaleContent(locale);
const unlocalizedPath = stripLocaleFromPath(currentPath);
const languagePath = unlocalizedPath === "/404" ? "/" : unlocalizedPath;
const interactionCopy = {
  en: {
    main: "Main navigation",
    open: "Open navigation menu",
    close: "Close navigation menu",
    light: "Switch to light theme",
    dark: "Switch to dark theme",
  },
  "zh-cn": {
    main: "主导航",
    open: "打开导航菜单",
    close: "关闭导航菜单",
    light: "切换至浅色主题",
    dark: "切换至深色主题",
  },
  "zh-hk": {
    main: "主要導覽",
    open: "開啟導覽選單",
    close: "關閉導覽選單",
    light: "切換至淺色主題",
    dark: "切換至深色主題",
  },
  ja: {
    main: "メインナビゲーション",
    open: "ナビゲーションを開く",
    close: "ナビゲーションを閉じる",
    light: "ライトテーマに切り替え",
    dark: "ダークテーマに切り替え",
  },
  ko: {
    main: "기본 탐색",
    open: "탐색 메뉴 열기",
    close: "탐색 메뉴 닫기",
    light: "라이트 테마로 전환",
    dark: "다크 테마로 전환",
  },
}[locale];
---

<a class="skip-link" href="#main">
  {copy.nav.skip}
</a>
<header class="site-header">
  <div class="shell nav-shell">
    <a
      class="brand"
      href={withBase(localeHref(locale, "/"))}
      aria-label={`Zevqio ${copy.common.home}`}
    >
      <svg
        class="brand-mark"
        width="33"
        height="33"
        viewBox="0 0 38 38"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M19 2.8 35 12v14L19 35.2 3 26V12L19 2.8Z"
          stroke="currentColor"
          stroke-width="1.4"
        />
        <path
          d="m12 13 14 0-8 12h8M12 25h6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="27" cy="13" r="1.25" fill="currentColor" />
      </svg>
      <span class="brand-word">
        zevqio<span class="brand-period">.</span>
      </span>
    </a>

    <button
      class="icon-button menu-toggle"
      type="button"
      aria-label={copy.nav.menu}
      aria-controls="primary-navigation"
      aria-expanded="false"
      data-menu-label-open={interactionCopy.open}
      data-menu-label-close={interactionCopy.close}
      data-menu-toggle
    >
      <span data-menu-icon>
        <Icon name="menu" size={21} />
      </span>
      <span data-close-icon hidden>
        <Icon name="x" size={21} />
      </span>
    </button>

    <nav
      class="primary-navigation"
      id="primary-navigation"
      aria-label={interactionCopy.main}
      data-navigation
    >
      <div class="nav-links">
        {site.navigation.map((item, index) => {
          const labels = [
            copy.nav.products,
            copy.nav.solutions,
            copy.nav.projects,
            copy.nav.about,
            copy.nav.contact,
          ];
          const href = localeHref(locale, item.href);
          const activePath = href.split("#")[0];
          const normalizedCurrent = stripLocaleFromPath(currentPath);
          const isActive =
            !item.href.startsWith("/#") && normalizedCurrent === activePath;
          return (
            <a
              class:list={["nav-link", { active: isActive }]}
              href={withBase(href)}
              aria-current={isActive ? "page" : undefined}
            >
              {labels[index]}
            </a>
          );
        })}
      </div>
      <div class="nav-actions">
        <details class="language-switcher">
          <summary aria-label={copy.nav.language}>
            {localeOptions.find((option) => option.code === locale)?.tag ??
              "EN"}
            <Icon name="chevronDown" size={13} />
          </summary>
          <div class="language-menu" aria-label={copy.nav.language}>
            {localeOptions.map((option) => (
              <a
                href={withBase(localeHref(option.code, languagePath))}
                lang={option.lang}
                aria-current={option.code === locale ? "page" : undefined}
              >
                <span>{option.label}</span>
                {option.code === locale && <span aria-hidden="true">✓</span>}
              </a>
            ))}
          </div>
        </details>
        <button
          class="icon-button theme-toggle"
          type="button"
          data-theme-toggle
          aria-label={interactionCopy.light}
          data-theme-label-light={interactionCopy.light}
          data-theme-label-dark={interactionCopy.dark}
        >
          <span data-theme-icon-dark>
            <Icon name="sun" size={17} />
          </span>
          <span data-theme-icon-light hidden>
            <Icon name="moon" size={17} />
          </span>
        </button>
        <a
          class="button button-small button-outline nav-cta"
          href={withBase(localeHref(locale, "/contact"))}
        >
          {copy.nav.cta} <Icon name="arrowUpRight" size={15} />
        </a>
      </div>
    </nav>
  </div>
</header>
