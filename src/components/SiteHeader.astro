---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import { withBase } from "../utils/paths";

const currentPath = Astro.url.pathname;
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-header">
  <div class="shell nav-shell">
    <a class="brand" href={withBase("/")} aria-label="Zevqio home">
      <svg
        class="brand-mark"
        viewBox="0 0 38 38"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M19 2.8 35 12v14L19 35.2 3 26V12L19 2.8Z"
          stroke="currentColor"
          stroke-width="1.4"
        />
        <path
          d="m12 13 14 0-8 12h8M12 25h6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="27" cy="13" r="1.25" fill="currentColor" />
      </svg>
      <span class="brand-word">
        zevqio<span class="brand-period">.</span>
      </span>
    </a>

    <button
      class="icon-button menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-controls="primary-navigation"
      aria-expanded="false"
      data-menu-toggle
    >
      <span data-menu-icon>
        <Icon name="menu" size={21} />
      </span>
      <span data-close-icon hidden>
        <Icon name="x" size={21} />
      </span>
    </button>

    <nav
      class="primary-navigation"
      id="primary-navigation"
      aria-label="Main navigation"
      data-navigation
    >
      <div class="nav-links">
        {site.navigation.map((item) => {
          const isActive =
            !item.href.startsWith("/#") && currentPath === withBase(item.href);
          return (
            <a
              class:list={["nav-link", { active: isActive }]}
              href={withBase(item.href)}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </div>
      <div class="nav-actions">
        <button
          class="icon-button theme-toggle"
          type="button"
          data-theme-toggle
          aria-label="Switch to light theme"
        >
          <span data-theme-icon-dark>
            <Icon name="sun" size={17} />
          </span>
          <span data-theme-icon-light hidden>
            <Icon name="moon" size={17} />
          </span>
        </button>
        <a
          class="button button-small button-outline nav-cta"
          href={withBase("/contact")}
        >
          Get in touch <Icon name="arrowUpRight" size={15} />
        </a>
      </div>
    </nav>
  </div>
</header>
