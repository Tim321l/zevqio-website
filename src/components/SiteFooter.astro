---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import { withBase } from "../utils/paths";
import {
  getLocaleContent,
  getStudioLabels,
  localeHref,
  type Locale,
} from "../data/locales";
const { locale = "en" } = Astro.props as { locale?: Locale };
const copy = getLocaleContent(locale);
const studioLabels = getStudioLabels(locale);
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-main">
      <div class="footer-brand-block">
        <a
          class="brand"
          href={withBase(localeHref(locale, "/"))}
          aria-label={`Zevqio ${copy.common.home}`}
        >
          <svg
            class="brand-mark"
            width="33"
            height="33"
            viewBox="0 0 38 38"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M19 2.8 35 12v14L19 35.2 3 26V12L19 2.8Z"
              stroke="currentColor"
              stroke-width="1.4"
            />
            <path
              d="m12 13 14 0-8 12h8M12 25h6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle cx="27" cy="13" r="1.25" fill="currentColor" />
          </svg>
          <span class="brand-word">
            zevqio<span class="brand-period">.</span>
          </span>
        </a>
        <p>{copy.footer.tagline}</p>
      </div>
      <div class="footer-column">
        <h2>{copy.footer.explore}</h2>
        <a href={withBase(localeHref(locale, "/products"))}>
          {copy.nav.products}
        </a>
        <a href={withBase(localeHref(locale, "/#solutions"))}>
          {copy.nav.solutions}
        </a>
        <a href={withBase(localeHref(locale, "/about"))}>
          {studioLabels.about}
        </a>
      </div>
      <div class="footer-column">
        <h2>{copy.footer.connect}</h2>
        <a href={withBase(localeHref(locale, "/contact"))}>
          {copy.nav.contact}
        </a>
        <a href={`mailto:${site.email}`}>
          {copy.footer.email} <Icon name="arrowUpRight" size={13} />
        </a>
        <a href={withBase(localeHref(locale, "/privacy"))}>
          {copy.footer.privacy}
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} Zevqio. {copy.footer.copyright}
      </span>
      <span class="footer-location">
        <span class="status-dot" aria-hidden="true"></span>{" "}
        {copy.footer.building}
      </span>
    </div>
  </div>
</footer>
