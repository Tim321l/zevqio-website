---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import { withBase } from "../utils/paths";
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-main">
      <div class="footer-brand-block">
        <a class="brand" href={withBase("/")} aria-label="Zevqio home">
          <svg
            class="brand-mark"
            width="33"
            height="33"
            viewBox="0 0 38 38"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M19 2.8 35 12v14L19 35.2 3 26V12L19 2.8Z"
              stroke="currentColor"
              stroke-width="1.4"
            />
            <path
              d="m12 13 14 0-8 12h8M12 25h6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle cx="27" cy="13" r="1.25" fill="currentColor" />
          </svg>
          <span class="brand-word">
            zevqio<span class="brand-period">.</span>
          </span>
        </a>
        <p>Practical software for the work that moves business forward.</p>
      </div>
      <div class="footer-column">
        <h2>Explore</h2>
        <a href={withBase("/products")}>Products</a>
        <a href={withBase("/#solutions")}>Capabilities</a>
        <a href={withBase("/about")}>About Zevqio</a>
      </div>
      <div class="footer-column">
        <h2>Connect</h2>
        <a href={withBase("/contact")}>Contact</a>
        <a href={`mailto:${site.email}`}>
          Email the founder <Icon name="arrowUpRight" size={13} />
        </a>
        <a href={withBase("/privacy")}>Privacy</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} Zevqio. An independent software initiative.
      </span>
      <span class="footer-location">
        <span class="status-dot" aria-hidden="true"></span> Building with
        intention
      </span>
    </div>
  </div>
</footer>
