---
import {
  ArrowDownRight,
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  Blocks,
  Braces,
  Check,
  ChevronDown,
  ChevronRight,
  CodeXml,
  FileText,
  AudioLines,
  Gamepad2,
  Globe,
  Layers,
  Mail,
  Menu,
  Moon,
  ScanText,
  ShieldCheck,
  Sparkles,
  Sun,
  UserRoundCheck,
  Workflow,
  X,
} from "@lucide/astro";

const icons = {
  arrowDownRight: ArrowDownRight,
  arrowLeft: ArrowLeft,
  arrowRight: ArrowRight,
  arrowUpRight: ArrowUpRight,
  audio: AudioLines,
  blocks: Blocks,
  braces: Braces,
  check: Check,
  chevronDown: ChevronDown,
  chevronRight: ChevronRight,
  code: CodeXml,
  file: FileText,
  gamepad: Gamepad2,
  web: Globe,
  layers: Layers,
  mail: Mail,
  menu: Menu,
  moon: Moon,
  scan: ScanText,
  shield: ShieldCheck,
  sparkles: Sparkles,
  sun: Sun,
  "user-check": UserRoundCheck,
  workflow: Workflow,
  x: X,
} as const;

type IconName = keyof typeof icons;
const {
  name,
  size = 20,
  strokeWidth = 1.7,
  class: className = "",
} = Astro.props as {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
};
const Icon = icons[name];
---

<Icon {size} stroke-width={strokeWidth} class={className} aria-hidden="true" />
