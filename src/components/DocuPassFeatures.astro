---
import {
  docuFeatureGroups,
  docuFeatureLabels as labels,
  docuDocumentTypes,
} from "../data/docupass-features";
import type { Locale } from "../data/locales";
import Icon from "./Icon.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section
  class="docu-capabilities section-space"
  id="docupass-features"
  aria-labelledby="docu-features-title"
>
  <div class="shell">
    <div class="showcase-heading">
      <div>
        <p class="eyebrow">
          <span class="eyebrow-line"></span>
          {labels.eyebrow[locale]}
        </p>
        <h2 id="docu-features-title">{labels.title[locale]}</h2>
      </div>
      <p>{labels.intro[locale]}</p>
    </div>
    <nav class="docu-feature-index" aria-label={labels.eyebrow[locale]}>
      {docuFeatureGroups.map((group) => (
        <a href={`#${group.id}`}>{group.title[locale]}</a>
      ))}
    </nav>
    <div class="docu-types-block">
      <h3>{labels.types[locale]}</h3>
      <div class="docu-types-table">
        <table>
          <thead>
            <tr>
              <th scope="col">{labels.document[locale]}</th>
              <th scope="col">{labels.fields[locale]}</th>
            </tr>
          </thead>
          <tbody>
            {docuDocumentTypes.map(([name, description]) => (
              <tr>
                <th scope="row">{name[locale]}</th>
                <td>{description[locale]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div class="docu-capability-grid">
      {docuFeatureGroups.map((group) => (
        <article class="docu-capability" id={group.id}>
          <h3>{group.title[locale]}</h3>
          <ul>
            {group.items.map((item) => (
              <li>
                <Icon name="check" size={16} />
                <span>{item[locale]}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <div class="docu-capability-links">
      <a class="button button-primary" href="#docupass-demo">
        {labels.screens[locale]}
        <Icon name="arrowRight" size={16} />
      </a>
      <a class="button button-secondary" href="#ocr-results">
        {labels.results[locale]}
      </a>
      <a class="text-link" href="#handwriting-results">
        {labels.handwriting[locale]}
        <Icon name="arrowRight" size={16} />
      </a>
      <a
        class="text-link"
        href="https://github.com/Tim321l/paddleocr-studio/blob/bf86a8c1853b976cdba95610fd5515ce46b5a5b9/README.md#features"
        target="_blank"
        rel="noopener noreferrer"
      >
        {labels.source[locale]}
        <Icon name="arrowUpRight" size={16} />
      </a>
    </div>
  </div>
</section>
