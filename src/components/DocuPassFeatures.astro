---
import {
  docuFeatureGroups,
  docuFeatureLabels as labels,
  docuDocumentTypes,
} from "../data/docupass-features";
import type { Locale } from "../data/locales";
import Icon from "./Icon.astro";
import DocuPassStory from "./DocuPassStory.astro";
import { docuStory } from "../data/docupass-story";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<DocuPassStory {locale} />
<section
  class="docu-capabilities docu-technical-section section-space"
  aria-label={docuStory.details[locale]}
>
  <div class="shell">
    <details class="docu-technical-details">
      <summary>{docuStory.details[locale]}</summary>
      <div class="showcase-heading docu-feature-guide-heading">
        <div>
          <p class="eyebrow">
            <span class="eyebrow-line"></span>
            {labels.eyebrow[locale]}
          </p>
          <h2 id="docu-features-title">{labels.title[locale]}</h2>
        </div>
        <p>{labels.intro[locale]}</p>
      </div>
      <details class="docu-types-detail">
        <summary>
          <span class="docu-detail-number">01</span>
          <span class="docu-detail-label">
            <strong>{labels.types[locale]}</strong>
            <small>{labels.typeSummary[locale]}</small>
          </span>
          <span class="docu-detail-toggle" aria-hidden="true"></span>
        </summary>
        <div class="docu-types-table">
          <table>
            <thead>
              <tr>
                <th scope="col">{labels.document[locale]}</th>
                <th scope="col">{labels.fields[locale]}</th>
              </tr>
            </thead>
            <tbody>
              {docuDocumentTypes.map(([name, description]) => (
                <tr>
                  <th scope="row">{name[locale]}</th>
                  <td>{description[locale]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
      <div class="docu-capability-grid">
        {docuFeatureGroups.map((group, index) => (
          <details class="docu-capability" id={group.id}>
            <summary>
              <span class="docu-detail-number">
                {(index + 2).toString().padStart(2, "0")}
              </span>
              <strong>{group.title[locale].replace(/^\d+\s*\/\s*/, "")}</strong>
              <span class="docu-detail-toggle" aria-hidden="true"></span>
            </summary>
            <ul>
              {group.items.map((item) => (
                <li>
                  <Icon name="check" size={16} />
                  <span>{item[locale]}</span>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
      <div class="docu-capability-links">
        <a class="button button-primary" href="#docupass-demo">
          {labels.screens[locale]}
          <Icon name="arrowRight" size={16} />
        </a>
        <a class="button button-outline" href="#ocr-results">
          {labels.results[locale]}
        </a>
        <a class="text-link" href="#handwriting-results">
          {labels.handwriting[locale]}
          <Icon name="arrowRight" size={16} />
        </a>
      </div>
    </details>
  </div>
</section>
