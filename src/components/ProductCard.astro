---
import type { Product } from "../data/products";
import { productStatusLabel } from "../data/products";
import Icon from "./Icon.astro";
import { withBase } from "../utils/paths";

const { product } = Astro.props as { product: Product };
const productUrl = withBase(`/products/${product.slug}`);
---

<article class:list={["product-card", `accent-${product.accent}`]}>
  <div class="product-card-top">
    <span class="product-icon">
      <Icon name={product.icon} size={23} />
    </span>
    <span class="status-pill">
      <span class="status-dot" aria-hidden="true"></span>
      {productStatusLabel(product.stage)}
    </span>
  </div>
  <p class="card-category">{product.category}</p>
  <h3>
    <a href={productUrl}>{product.name}</a>
  </h3>
  <p class="product-card-copy">{product.summary}</p>
  <a
    class="text-link"
    href={productUrl}
    aria-label={`Learn about ${product.name}`}
  >
    Explore product <Icon name="arrowUpRight" size={16} />
  </a>
</article>
