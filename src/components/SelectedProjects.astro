---
import Icon from "./Icon.astro";
import { selectedProjects } from "../data/projects";
import { withBase } from "../utils/paths";
---

<section class="selected-projects-section section-space" id="selected-projects">
  <div class="shell">
    <div class="section-heading heading-split">
      <div>
        <p class="eyebrow">
          <span class="eyebrow-line"></span> Selected projects
        </p>
        <h2>
          Work across
          <br />
          <span class="text-muted">code and sound.</span>
        </h2>
      </div>
      <p class="section-intro">
        Explore RimRise in two forms: a browser basketball game and a Unity
        prototype. The portfolio also includes independent web and original
        audio work.
      </p>
    </div>
    <div class="principle-grid selected-project-grid">
      {selectedProjects.map((project, index) => (
        <article
          class:list={[
            "principle-card",
            "selected-project-card",
            `accent-${project.accent}`,
          ]}
        >
          <div class="principle-top">
            <span class="principle-icon">
              <Icon name={project.icon} size={22} />
            </span>
            <span>0{index + 1}</span>
          </div>
          <h3>{project.name}</h3>
          <p>{project.summary}</p>
          <ul
            class="selected-project-tags"
            aria-label={`${project.name} tools`}
          >
            {project.tools.map((tool) => (
              <li>{tool}</li>
            ))}
          </ul>
          {project.href && (
            <a
              class="text-link selected-project-link"
              href={withBase(project.href)}
            >
              Explore project <Icon name="arrowUpRight" size={16} />
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
