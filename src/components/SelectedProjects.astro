---
import Icon from "./Icon.astro";
import { selectedProjects } from "../data/projects";
import { withBase } from "../utils/paths";
---

<section class="selected-projects-section section-space" id="selected-projects">
  <div class="shell">
    <div class="section-heading heading-split">
      <div>
        <p class="eyebrow">
          <span class="eyebrow-line"></span> Selected projects
        </p>
        <h2>
          Games and independent
          <br />
          <span class="text-muted">creative work.</span>
        </h2>
      </div>
      <p class="section-intro">
        Explore four game builds: RimRise in browser and Unity versions, BigDeal
        HK, and Song Guess Online. The portfolio also includes independent web
        and original audio work.
      </p>
    </div>
    <div class="principle-grid selected-project-grid">
      {selectedProjects.map((project, index) => (
        <article
          class:list={[
            "principle-card",
            "selected-project-card",
            `selected-project-card--${project.href?.split("/").at(-1) ?? "audio"}`,
            `accent-${project.accent}`,
          ]}
        >
          {project.image && (
            <div
              class:list={[
                "selected-project-preview",
                project.imageAspect === "square" &&
                  "selected-project-preview--square",
                project.imageAspect === "cinema" &&
                  "selected-project-preview--cinema",
                project.imagePosition === "top" &&
                  "selected-project-preview--top",
              ]}
            >
              <img
                src={withBase(project.image)}
                alt=""
                width={project.imageAspect === "square" ? 1000 : 1440}
                height={project.imageAspect === "square" ? 1000 : 900}
                loading="lazy"
              />
            </div>
          )}
          <div class="principle-top">
            <span class="principle-icon">
              <Icon name={project.icon} size={22} />
            </span>
            <span>0{index + 1}</span>
          </div>
          <h3>{project.name}</h3>
          <p>{project.summary}</p>
          <ul
            class="selected-project-tags"
            aria-label={`${project.name} tools`}
          >
            {project.tools.map((tool) => (
              <li>{tool}</li>
            ))}
          </ul>
          {project.href && (
            <a
              class="text-link selected-project-link"
              href={withBase(project.href)}
            >
              Explore project <Icon name="arrowUpRight" size={16} />
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
